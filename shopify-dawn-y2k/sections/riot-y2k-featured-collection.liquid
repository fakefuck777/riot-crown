{% comment %}
  RIOT Y2K — Featured collection with chrome-hover wrappers around Dawn card-product.
  Requires: riot-y2k-luxury.css + Dawn snippet `card-product` (default Dawn).
{% endcomment %}

{{ 'riot-y2k-luxury.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected = section.settings.collection
  if selected == blank
    assign selected = collections.all
  endif
  assign ratio = section.settings.media_ratio
  assign limit = section.settings.products_to_show | default: 8
-%}

<section
  class="riot-y2k-product-section"
  style="--riot-sec-pt: {{ section.settings.padding_top }}px; --riot-sec-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% if section.settings.eyebrow != blank or section.settings.title != blank %}
      <header class="riot-y2k-product-section__head">
        {% if section.settings.eyebrow != blank %}
          <p class="riot-y2k-product-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="riot-y2k-product-section__title">{{ section.settings.title | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="riot-y2k-product-section__sub">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </header>
    {% endif %}

    {% if selected == blank or selected.products_count == 0 %}
      <p style="text-align:center;color:rgba(200,206,220,0.55);padding:2rem;">No products in this collection yet.</p>
    {% else %}
      <ul
        class="riot-y2k-product-grid"
        style="--riot-cols-mobile: {{ section.settings.columns_mobile }}; --riot-cols-tablet: {{ section.settings.columns_tablet }}; --riot-cols-desktop: {{ section.settings.columns_desktop }};"
        data-riot-chrome-grid
      >
        {% for product in selected.products limit: limit %}
          <li>
            <div
              class="riot-card-y2k{% if section.settings.holo_border %} riot-card-y2k--holo{% endif %}"
              data-riot-chrome-card
            >
              <div class="riot-card-y2k__corners" aria-hidden="true"></div>
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                section_id: section.id
              %}
            </div>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

<script src="{{ 'riot-y2k-runtime.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "RIOT Y2K Collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2,
      "label": "Columns (mobile)"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns (tablet)"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns (desktop)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ICONIC DROPS · Y2K VOID"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Bling for the ritual"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Chrome, crystal, nostalgia — pieces that hit different after dark."
    },
    {
      "type": "checkbox",
      "id": "holo_border",
      "label": "Holographic border on cards",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "RIOT Y2K Collection"
    }
  ]
}
{% endschema %}
