{% comment %}
  RIOT Y2K Hero — Dark Y2K Luxury / Cyber Occult Bling / Void Ritual 2000s
  Assets: riot-y2k-luxury.css  |  Theme editor → Add section → RIOT Y2K Hero
{% endcomment %}

{{ 'riot-y2k-luxury.css' | asset_url | stylesheet_tag }}
{% render 'riot-y2k-fonts' %}

<section class="riot-y2k-hero riot-y2k-force-dark" id="riot-y2k-hero-{{ section.id }}">
  <div class="riot-y2k-hero__mesh" aria-hidden="true"></div>
  {% if section.settings.show_chrome_ring %}
    <div class="riot-y2k-hero__chrome-ring" aria-hidden="true"></div>
  {% endif %}
  <div class="riot-y2k-hero__scan" aria-hidden="true"></div>

  <div
    class="riot-sparkle-field"
    data-riot-sparkles
    data-sparkle-count="{{ section.settings.sparkle_count }}"
    aria-hidden="true"
  ></div>

  <div class="riot-y2k-hero__vignette" aria-hidden="true"></div>

  <div class="riot-y2k-hero__inner riot-millennial-shell">
    {% if section.settings.show_glyphs %}
      <div class="riot-y2k-glyphs" aria-hidden="true">
        <span title="butterfly">🦋</span>
        <span>✦</span>
        <span title="heart">♡</span>
        <span>✧</span>
        <span title="lock">🔒</span>
        <span>▪</span>
        <span title="pixel">◼</span>
        <span>✟</span>
        <span>★</span>
      </div>
      <div style="height: 1rem"></div>
    {% endif %}

    {% if section.settings.show_marquee %}
      <div class="riot-y2k-marquee" aria-hidden="true">
        <div class="riot-y2k-marquee__track">
          <span>{{ section.settings.marquee_text | escape }}</span>
          <span>{{ section.settings.marquee_text | escape }}</span>
        </div>
      </div>
    {% endif %}

    {% if section.settings.eyebrow != blank %}
      <p class="riot-y2k-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    <h1 class="riot-y2k-hero__title">
      {% if section.settings.title_style == 'gradient' %}
        <span class="riot-y2k-gradient-title">{{ section.settings.heading | escape }}</span>
      {% else %}
        <span class="riot-chrome-title">{{ section.settings.heading | escape }}</span>
      {% endif %}
    </h1>

    {% if section.settings.subheading != blank %}
      <p class="riot-y2k-hero__sub">{{ section.settings.subheading | newline_to_br }}</p>
    {% endif %}

    <div class="riot-y2k-hero__actions">
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="riot-btn-y2k">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a href="{{ section.settings.secondary_link }}" class="riot-btn-ghost">
          {{ section.settings.secondary_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<script src="{{ 'riot-y2k-runtime.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "RIOT Y2K Hero",
  "tag": "section",
  "class": "section section--riot-y2k-hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_glyphs",
      "label": "Y2K symbol row (butterfly / star / etc.)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_marquee",
      "label": "Bling marquee strip",
      "default": true
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "✦ BLING ✦ ICONIC ✦ NOSTALGIA ✦ VOID RITUAL ✦ CHROME ✦ 2000s ✦"
    },
    {
      "type": "checkbox",
      "id": "show_chrome_ring",
      "label": "Chrome orbital ring (background)",
      "default": true
    },
    {
      "type": "range",
      "id": "sparkle_count",
      "min": 24,
      "max": 120,
      "step": 4,
      "default": 72,
      "label": "Sparkle particle count"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VOID ATELIER · THE ERA REMEMBERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RIOT CROWN"
    },
    {
      "type": "select",
      "id": "title_style",
      "label": "Title style",
      "options": [
        { "value": "chrome", "label": "Chrome metal (millennial-clean shine)" },
        { "value": "gradient", "label": "Y2K holo gradient" }
      ],
      "default": "chrome"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "The night remembers what the day forgot — stay iconic. Dark ritual meets early-2000s bling: chrome, crystal, pure nostalgia. Limited drops. Zero apologies."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "SHOP THE VOID"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "NEW DROPS"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    }
  ],
  "presets": [{ "name": "RIOT Y2K Hero" }]
}
{% endschema %}
