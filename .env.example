# =============================================================================
# Shopify + Hydrogen (see server.ts — MiniOxygen injects these at runtime)
# =============================================================================
#
# A) SESSION_SECRET
#    Random string, 32+ characters (used to sign the httpOnly session cookie).
#    Example:  openssl rand -hex 32
#
# B) PUBLIC_STORE_DOMAIN
#    Must be the shop’s myshopify.com hostname only — no https://, no trailing slash,
#    and NOT your custom storefront domain (e.g. not riotcrown.shop):
#      dkgv9c-tv.myshopify.com
#    Wrong values are the #1 cause of empty Storefront responses / auth failures.
#
# C) PUBLIC_STOREFRONT_API_TOKEN  ← exact name (common typo: PUBLIC_STOREFRONT_APITOKEN — wrong)
#    Must be the **Storefront API** access token from that app’s “Storefront API” section (often a
#    long hex string). Do NOT paste the **Admin API** secret (commonly starts with `shpat_`) —
#    it authenticates a different API and Storefront GraphQL will reject or return empty data.
#    Shopify Admin → Settings → Apps and sales channels → Develop apps
#    → Create an app → Configuration → Storefront API → choose scopes
#    (at minimum: unauthenticated read for what you’ll query, e.g. products)
#    → Install app → copy the Storefront API access token (public token).
#    Minimum scopes (names may vary slightly in Admin UI): enable at least
#    `unauthenticated_read_product_listings` and unauthenticated read of products / collections
#    for what your GraphQL queries touch. Missing `…product_listings` is a very common reason
#    listings return empty. Inventory-only fields were removed from catalog queries to avoid
#    scope-related full-query failures.
#
#    Hydrogen in Shopify Admin: your storefront → “Storefront API” / env pull may expose the
#    public token; it must match this env var name exactly: PUBLIC_STOREFRONT_API_TOKEN.
#
#    Markets / International: the token’s effective catalog still depends on Storefront channel
#    publication + market availability. If `product` is null, confirm Active status, Storefront
#    channel publish, and Markets; then set PUBLIC_STOREFRONT_LANGUAGE / PUBLIC_STOREFRONT_COUNTRY
#    to match the market you browse as EN-unprefixed URLs (see resolveStorefrontI18nForRequest).
#
#    Or use the Headless / Hydrogen channel flow from Shopify docs if you
#    prefer that over a custom app.
#
# Dev note: mock.shop + mock-token work for local demos without a real shop.
#
SESSION_SECRET=replace-with-32-plus-random-chars-minimum
PUBLIC_STOREFRONT_API_TOKEN=your-storefront-api-access-token
PUBLIC_STORE_DOMAIN=your-store.myshopify.com

# Storefront API @inContext defaults (Hydrogen createStorefrontClient). Used when URL has no
# locale prefix and `riot_locale` is EN/absent (see resolveStorefrontI18nForRequest in storefrontI18n.ts).
# Example Tokyo-primary: JA + JP. If unset, getStorefrontI18n falls back to EN + US.
# PUBLIC_STOREFRONT_LANGUAGE=JA
# PUBLIC_STOREFRONT_COUNTRY=JP

# Optional: home page + search + sitemap only list products from this collection (handle slug).
# If unset, or the collection does not exist, the site lists all published products (up to 48).
# PUBLIC_HOME_COLLECTION_HANDLE=frontpage

# Optional: custom checkout host (default is fine for most shops)
# PUBLIC_CHECKOUT_DOMAIN=checkout.shopify.com

# Optional: Google Analytics 4 — see app/entry.client.tsx
# VITE_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: client monitoring (see app/lib/monitoring.client.ts, app/entry.client.tsx)
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# VITE_WEB_VITALS_IN_DEV=1
# Server: log POST /api/web-vitals bodies when set to 1
# DEBUG_WEB_VITALS=1
